# ---------------------------------------------------------------------------
# Private configuration. Copy this file to .env ONLY if you want to fill in
# values yourself. Normally the app creates .env automatically on first start.
# Never commit .env to Git or share it.
# ---------------------------------------------------------------------------

# Flask session signing key. Leave blank to auto-generate.
SECRET_KEY=

# Admin login. The app creates/updates the admin account from these values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Web Push VAPID keys. Leave blank to auto-generate a pair.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Use your own email address (mailto:) as required by the Web Push protocol.
VAPID_SUBJECT=mailto:change-me@example.com

# Database location (relative paths are from the project root).
DATABASE_PATH=instance/school_bus.db

# Waitress binds to localhost only. Cloudflare Tunnel reaches it locally.
HOST=127.0.0.1
PORT=8000

# Your public hostname, used only for display/instructions.
PUBLIC_BASE_URL=https://bus.example.com

# OSRM routing service. Change this if you use a self-hosted OSRM later.
OSRM_BASE_URL=https://router.project-osrm.org

# auto = secure cookies (correct for Cloudflare HTTPS). Set false only when
# testing over plain http://127.0.0.1 in a browser that rejects secure cookies.
SESSION_COOKIE_SECURE=auto

# GPS history cleanup and backup retention.
GPS_HISTORY_DAYS=7
BACKUP_KEEP_COUNT=30

# Label shown after times in the UI.
TIMEZONE_LABEL=Local time
